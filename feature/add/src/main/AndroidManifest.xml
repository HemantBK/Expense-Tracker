<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Feature declaration (not permission) — TakePicturePreview does NOT need CAMERA
         permission; it launches the system camera activity which asks for its own consent.
         We advertise the camera feature so filtering on Play/F-Droid is accurate. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
