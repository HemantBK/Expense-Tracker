# Default line endings
* text=auto eol=lf

# Kotlin / Gradle / Config — text
*.kt     text diff=kotlin
*.kts    text diff=kotlin
*.java   text diff=java
*.xml    text
*.yml    text
*.yaml   text
*.toml   text
*.md     text
*.json   text
*.properties text

# Shell / CI
*.sh     text eol=lf
gradlew  text eol=lf
*.bat    text eol=crlf

# Binary — never normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.apk    binary
*.aab    binary
*.jar    binary
*.keystore binary
*.tflite binary
*.traineddata binary
*.gguf   binary

# Lockfiles
gradle/verification-metadata.xml text eol=lf

# Generated / exported
schemas/**/*.json text
